// FXDESK Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS & AUTH ─────────────────────────────────────────────
model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  role            String   @default("USER") // USER | ADMIN
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  loginMethod     String   @default("EMAIL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  loginDays       Int      @default(0)
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  avatarUrl       String?

  // Relations
  premium         PremiumAccess?
  trial           TrialUsage?
  credits         UserCredits?
  points          UserPoints?
  sessions        Session[]
  checklistHistory ChecklistHistory[]
  paperTrades     PaperTrade[]
  positions       Position[]
  orders          Order[]
  orderHistory    OrderHistory[]
  strategies      Strategy[]
  journals        Journal[]
  trainingResults TrainingResult[]
  orderFlowSessions OrderFlowSession[]
  coursePurchases CoursePurchase[]
  courseReviews   CourseReview[]
  coursesCreated  Course[]
  sellerAccount   SellerAccount?
  withdrawals     Withdrawal[]
  referralsMade   AffiliateReferral[] @relation("Referrer")
  referralReceived AffiliateReferral? @relation("Referred")
  reports         Report[]
  auditLogsTarget AuditLog[] @relation("AuditTarget")
  leaderboard     Leaderboard?
  analytics       Analytics?

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  refreshToken String? @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── PREMIUM ───────────────────────────────────────────────────
model PremiumAccess {
  id          String    @id @default(uuid())
  userId      String    @unique
  isActive    Boolean   @default(false)
  startedAt   DateTime?
  expiresAt   DateTime?
  planType    String    @default("MONTHLY") // 7D | 30D | 90D | CUSTOM
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("premium_access")
}

// ─── TRIAL ─────────────────────────────────────────────────────
model TrialUsage {
  id            String    @id @default(uuid())
  userId        String    @unique
  isActive      Boolean   @default(false)
  startedAt     DateTime?
  expiresAt     DateTime?
  creditsGiven  Int       @default(0)
  feedbackGiven Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trial_usage")
}

// ─── CREDITS ───────────────────────────────────────────────────
model UserCredits {
  id              String   @id @default(uuid())
  userId          String   @unique
  normalCredits   Int      @default(0)
  greenCredits    Int      @default(0)
  pendingGreen    Int      @default(0)
  withdrawableGreen Int    @default(0)
  usedNormal      Int      @default(0)
  totalEarnedGreen Int     @default(0)
  totalWithdrawnGreen Int  @default(0)
  updatedAt       DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("user_credits")
}

model CreditTransaction {
  id          String   @id @default(uuid())
  creditsId   String
  type        String   // EARN | SPEND | AWARD | REVERSE | WITHDRAW
  creditType  String   // NORMAL | GREEN
  amount      Int
  source      String   // ADMIN | AFFILIATE | CHECKLIST | COURSE_PURCHASE | COURSE_SALE | REFUND | BONUS | WITHDRAWAL
  description String?
  status      String   @default("COMPLETED") // COMPLETED | PENDING | REVERSED
  referenceId String?
  createdAt   DateTime @default(now())

  credits UserCredits @relation(fields: [creditsId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

// ─── POINTS ────────────────────────────────────────────────────
model UserPoints {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalPoints     Int      @default(0)
  checklistPoints Int      @default(0)
  tradingPoints   Int      @default(0)
  trainingPoints  Int      @default(0)
  affiliatePoints Int      @default(0)
  paperTradingPoints Int   @default(0)
  bonusPoints     Int      @default(0)
  dailyPoints     Int      @default(0)
  dailyPointsDate String?  // YYYY-MM-DD
  isFrozen        Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]
  leaderboard  Leaderboard?

  @@map("user_points")
}

model PointTransaction {
  id          String   @id @default(uuid())
  pointsId    String
  type        String   // EARN | DEDUCT | BONUS | RESET
  amount      Int
  source      String   // CHECKLIST | TRADING | TRAINING | ORDERFLOW | AFFILIATE | PAPER_TRADING | BONUS | ADMIN
  description String?
  createdAt   DateTime @default(now())

  points UserPoints @relation(fields: [pointsId], references: [id], onDelete: Cascade)

  @@map("point_transactions")
}

model Leaderboard {
  id          String   @id @default(uuid())
  userId      String   @unique
  pointsId    String   @unique
  totalPoints Int      @default(0)
  rank        Int      @default(0)
  isVisible   Boolean  @default(true)
  isFrozen    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  points UserPoints @relation(fields: [pointsId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}

// ─── DAILY CHECKLIST ───────────────────────────────────────────
model ChecklistTask {
  id            String   @id @default(uuid())
  name          String
  description   String?
  points        Int      @default(1)
  taskType      String   @default("GENERAL")
  requiredFeature String?
  displayOrder  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  history ChecklistHistory[]

  @@map("checklist_tasks")
}

model ChecklistHistory {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())
  date        String   // YYYY-MM-DD
  pointsEarned Int     @default(1)

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task ChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, date])
  @@map("checklist_history")
}

// ─── PAPER TRADING ─────────────────────────────────────────────
model PaperTrade {
  id          String   @id @default(uuid())
  userId      String
  pair        String
  type        String   // BUY | SELL
  lotSize     Float
  entryPrice  Float
  stopLoss    Float?
  takeProfit  Float?
  status      String   @default("OPEN") // OPEN | CLOSED | CANCELLED
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  exitPrice   Float?
  pnl         Float    @default(0)
  spread      Float    @default(0)
  pointsEarned Int     @default(0)
  date        String   // YYYY-MM-DD

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("paper_trades")
}

model Position {
  id           String   @id @default(uuid())
  userId       String
  pair         String
  type         String   // BUY | SELL
  lotSize      Float
  entryPrice   Float
  stopLoss     Float?
  takeProfit   Float?
  currentPrice Float?
  pnl          Float    @default(0)
  status       String   @default("OPEN") // OPEN | CLOSED
  openedAt     DateTime @default(now())
  closedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("positions")
}

model Order {
  id         String   @id @default(uuid())
  userId     String
  pair       String
  type       String   // BUY_LIMIT | SELL_LIMIT | BUY_STOP | SELL_STOP
  lotSize    Float
  entryPrice Float
  stopLoss   Float?
  takeProfit Float?
  status     String   @default("PENDING") // PENDING | FILLED | CANCELLED
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderHistory {
  id         String   @id @default(uuid())
  userId     String
  pair       String
  type       String
  lotSize    Float
  entryPrice Float
  exitPrice  Float?
  stopLoss   Float?
  takeProfit Float?
  spread     Float    @default(0)
  pnl        Float    @default(0)
  status     String   // CLOSED | CANCELLED
  openedAt   DateTime
  closedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("order_history")
}

// ─── TRADING TRAINING ──────────────────────────────────────────
model TradingQuestion {
  id              String   @id @default(uuid())
  question        String
  chartImageUrl   String?
  pair            String
  timeframe       String
  correctDirection String   // BUY | SELL | WAIT
  correctTrend    String   // UPTREND | DOWNTREND | RANGE
  explanation     String
  points          Int      @default(10)
  timerMinutes    Int      @default(10)
  publishDate     String?  // YYYY-MM-DD
  expiryDate      String?
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  results TrainingResult[]

  @@map("trading_questions")
}

model TrainingResult {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  direction  String   // BUY | SELL | WAIT
  trend      String   // UPTREND | DOWNTREND | RANGE
  reason     String?
  isCorrect  Boolean  @default(false)
  isDirectionCorrect Boolean @default(false)
  isTrendCorrect Boolean @default(false)
  pointsEarned Int    @default(0)
  submittedAt DateTime @default(now())
  date       String   // YYYY-MM-DD

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question TradingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("training_results")
}

// ─── ORDER FLOW TRAINING ───────────────────────────────────────
model OrderFlowLesson {
  id          String   @id @default(uuid())
  title       String
  description String?
  difficulty  String   @default("BEGINNER")
  points      Int      @default(10)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candles  OrderFlowCandle[]
  sessions OrderFlowSession[]

  @@map("order_flow_lessons")
}

model OrderFlowCandle {
  id          String   @id @default(uuid())
  lessonId    String
  index       Int
  open        Float
  high        Float
  low         Float
  close       Float
  bidVolume   Float
  askVolume   Float
  totalVolume Float
  delta       Float
  cumDelta    Float
  timestamp   String

  lesson OrderFlowLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("order_flow_candles")
}

model OrderFlowSession {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  predictions Int      @default(0)
  correct     Int      @default(0)
  accuracy    Float    @default(0)
  score       Int      @default(0)
  pointsEarned Int     @default(0)
  completedAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson OrderFlowLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("order_flow_sessions")
}

// ─── STRATEGY ──────────────────────────────────────────────────
model Strategy {
  id              String   @id @default(uuid())
  userId          String
  name            String
  description     String?
  entryRules      String?
  confirmationRules String?
  slRules         String?
  tpRules         String?
  riskRules       String?
  notes           String?
  chartImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strategies")
}

// ─── TRADE JOURNAL ─────────────────────────────────────────────
model Journal {
  id         String   @id @default(uuid())
  userId     String
  date       String   // YYYY-MM-DD
  time       String?
  title      String
  pair       String?
  imageUrl   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journals")
}

// ─── ANALYTICS ─────────────────────────────────────────────────
model Analytics {
  id               String   @id @default(uuid())
  userId           String   @unique
  totalTrades      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  winRate          Float    @default(0)
  totalRisk        Float    @default(0)
  totalProfit      Float    @default(0)
  totalLoss        Float    @default(0)
  avgRR            Float    @default(0)
  bestTrade        Float    @default(0)
  worstTrade       Float    @default(0)
  journalCount     Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

// ─── COURSES ───────────────────────────────────────────────────
model Course {
  id              String   @id @default(uuid())
  creatorId       String
  title           String
  description     String?
  thumbnailUrl    String?
  creditPrice     Int      @default(0)
  isFree          Boolean  @default(false)
  isPremium       Boolean  @default(false)
  status          String   @default("PENDING") // PENDING | APPROVED | PUBLISHED | REJECTED
  rejectionReason String?
  adminScore      Int      @default(0)
  completionRate  Float    @default(0)
  refundRate      Float    @default(0)
  rankScore       Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator   User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  purchases CoursePurchase[]
  reviews   CourseReview[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  content     String?
  videoUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model CoursePurchase {
  id           String   @id @default(uuid())
  userId       String
  courseId     String
  creditsPaid  Int
  status       String   @default("ACTIVE") // ACTIVE | REFUNDED
  purchasedAt  DateTime @default(now())
  refundedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_purchases")
}

model CourseReview {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int      // 1-5
  review    String?
  isVerified Boolean @default(false)
  status    String   @default("APPROVED") // APPROVED | HIDDEN
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_reviews")
}

// ─── SELLER ACCOUNT ────────────────────────────────────────────
model SellerAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  accountType   String   // BANK | PAYPAL | etc.
  accountName   String
  accountNumber String   // stored encrypted or hashed
  maskedNumber  String   // e.g. ****1234
  bankName      String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_accounts")
}

// ─── WITHDRAWALS ───────────────────────────────────────────────
model Withdrawal {
  id          String   @id @default(uuid())
  userId      String
  amount      Int      // green credits
  accountMask String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAID | CANCELLED
  adminNote   String?
  requestedAt DateTime @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

// ─── AFFILIATE ─────────────────────────────────────────────────
model AffiliateReferral {
  id           String   @id @default(uuid())
  referrerId   String
  referredId   String   @unique
  referralCode String
  clicks       Int      @default(0)
  isCompleted  Boolean  @default(false)
  creditsGiven Int      @default(0)
  pointsGiven  Int      @default(0)
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@map("affiliate_referrals")
}

// ─── TIPS ──────────────────────────────────────────────────────
model Tip {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  publishDate String?
  expiryDate  String?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tips")
}

// ─── BROKERS ───────────────────────────────────────────────────
model Broker {
  id             String   @id @default(uuid())
  name           String
  regulation     String?
  fees           String?
  minDeposit     String?
  platforms      String?
  accountTypes   String?
  description    String?
  websiteUrl     String?
  status         String   @default("PUBLISHED") // PUBLISHED | UNPUBLISHED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("brokers")
}

// ─── NEWS CACHE ────────────────────────────────────────────────
model NewsCache {
  id          String   @id @default(uuid())
  articleId   String   @unique // dedup key (url hash)
  title       String
  description String?
  url         String
  source      String?
  publishedAt String
  category    String   @default("General Market News")
  currency    String?
  imageUrl    String?
  cachedAt    DateTime @default(now())

  @@map("news_cache")
}

// ─── REPORTS ───────────────────────────────────────────────────
model Report {
  id        String   @id @default(uuid())
  userId    String
  category  String   // BUG | PROBLEM | WRONG_ANALYSIS | NEWS_ISSUE | OTHER
  message   String
  status    String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  adminNote String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// ─── ADMIN SETTINGS ────────────────────────────────────────────
model AdminSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("admin_settings")
}

// ─── FEATURE ACCESS ────────────────────────────────────────────
model FeatureAccess {
  id        String   @id @default(uuid())
  feature   String   @unique
  isEnabled Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("feature_access")
}

// ─── AUDIT LOG ─────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(uuid())
  adminId      String?
  adminName    String?
  action       String
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id])
  oldValue     String?
  newValue     String?
  reason       String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

// ─── ACTIVITY LOG ──────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  type      String   // LOGIN | CHECKLIST | TRAINING | TRADING | JOURNAL | REFERRAL | PREMIUM | PAPER_TRADE | COURSE
  date      String   // YYYY-MM-DD
  meta      String?  // JSON string
  createdAt DateTime @default(now())

  @@map("activity_logs")
}
